NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Roblox OAuth 2.0 confidential client. Never prefix the secret with NEXT_PUBLIC_.
ROBLOX_CLIENT_ID=your-roblox-oauth-client-id
ROBLOX_CLIENT_SECRET=your-roblox-oauth-client-secret
ROBLOX_REDIRECT_URI=http://localhost:3000/api/auth/roblox/callback

# Cloudinary signed uploads and deletion (server-only).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Roblox PBAL group ID (defaults to legacy 9515965)
ROBLOX_GROUP_ID=9515965

# Gemini Vision (server-only). Gemini 2.5 Flash supports image input and structured output.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when Google no longer serves 2.5 Flash to the API project.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Discord Application OAuth account linking.
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Discord Interactions / slash commands (server-only).
DISCORD_APPLICATION_ID=your-discord-application-id
DISCORD_PUBLIC_KEY=your-discord-application-public-key
DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional: guild-scoped commands update instantly while developing.
DISCORD_GUILD_ID=your-development-guild-id

# REST API credential for a separately hosted Discord bot. Use 32+ random characters.
PBAL_BOT_API_SECRET=replace-with-a-long-random-secret

# Discord incoming webhook and Supabase Database Webhook shared secret.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
SUPABASE_WEBHOOK_SECRET=replace-with-a-long-random-secret
